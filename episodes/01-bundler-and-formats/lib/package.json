{
  "name": "@ep1/lib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsdown --unbundle --format esm -d dist-unbundled --no-clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^5"
  }
}
