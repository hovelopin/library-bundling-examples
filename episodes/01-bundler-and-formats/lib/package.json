{
  "name": "@ep1/lib",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsdown --unbundle --format esm -d dist-unbundled --no-clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^5"
  }
}
