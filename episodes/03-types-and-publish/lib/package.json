{
  "name": "@ep3/lib",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "gen": "node gen.mjs",
    "build": "node gen.mjs && tsdown -c tsdown.oxc.config.ts",
    "build:tsc-dts": "node gen.mjs && tsdown -c tsdown.tsc.config.ts",
    "typecheck": "tsc --noEmit",
    "bench": "node bench.mjs",
    "publint": "publint",
    "attw": "attw --pack .",
    "pack:dry": "npm pack --dry-run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
